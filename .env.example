# Non-secret build-time configuration for Workers deployments.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-audience
# Bind an existing D1 database. Without an ID, cf can provision masterprep-study.
MASTERPREP_D1_ID=your-d1-database-uuid
AI_MODEL=claude-haiku-5-5
